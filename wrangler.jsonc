{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anyaparallax",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],

  // Structured application data (Slice 04). `database_id` is intentionally
  // absent: no Cloudflare resource has been created. Local development and the
  // checks use Wrangler's local D1 simulation, which needs only the name.
  // Provisioning steps (including setting the real id) are documented in
  // README.md under "Storage and data".
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "anyaparallax",
      "migrations_dir": "migrations"
    }
  ],

  // Two buckets, two security domains:
  //   MASTERS — private archival/print originals. Never served to visitors.
  //   IMAGES  — public web derivatives and gallery thumbnails.
  // Keep them separate so a bug in public serving cannot reach a master.
  "r2_buckets": [
    {
      "binding": "MASTERS",
      "bucket_name": "anyaparallax-masters",
      "preview_bucket_name": "anyaparallax-masters-dev"
    },
    {
      "binding": "IMAGES",
      "bucket_name": "anyaparallax-images",
      "preview_bucket_name": "anyaparallax-images-dev"
    }
  ],

  // Cloudflare Images binding (Slice 06 repair 01). This is the PRODUCTION image
  // processor: decode, trusted dimensions, resize, watermark draw and output
  // encoding all happen in the platform service rather than in Worker JavaScript,
  // so no full-resolution raster is ever allocated in the isolate.
  //
  // Named IMAGE_TRANSFORMS deliberately: `IMAGES` is already the R2 bucket that
  // holds public derivatives, and two bindings with one name would be a silent
  // aliasing bug in exactly the area this repair is about.
  //
  // `remote` is intentionally absent (false): local development uses Wrangler's
  // offline implementation, which performs no Cloudflare API call and incurs no
  // charge. High-fidelity draw behaviour is therefore isolated behind an adapter
  // and verified against a deterministic fake, with a live canary recorded as a
  // later publication gate.
  "images": {
    "binding": "IMAGE_TRANSFORMS"
  },

  // Development-only safety valves. Both must be "false" (or removed) for a real
  // deployment:
  //   ALLOW_DEVELOPMENT_SEED     — no D1 binding → serve the development seed set
  //                                instead of failing.
  //   ALLOW_DEVELOPMENT_IDENTITY — accept the local development identity header
  //                                (`x-anyaparallax-development-identity`) so the
  //                                authentication boundary can be exercised without
  //                                Cloudflare Access. Honoured on loopback hosts
  //                                only, and never while Access is configured.
  //
  // Cloudflare Access configuration (ACCESS_TEAM_DOMAIN, ACCESS_AUD) is
  // deliberately ABSENT here: no Access application exists yet and no value
  // belongs in the repository. The operator sets both for a deployment; see
  // README.md under "Authentication and roles". With neither Access nor the
  // development header available, every protected route denies (401/403).
  //
  // PUBLIC_SITE_ORIGIN is the CANONICAL public origin (Slice 07). Canonical
  // links, OpenGraph URLs and social preview images are built from it, so the
  // domain lives here rather than in markup, and a request's Host header can
  // never redefine it. The value is the operator-supplied production origin; it
  // is correct for local development too, because a canonical URL should point
  // at the real site even when the page is being previewed.
  "vars": {
    "ALLOW_DEVELOPMENT_SEED": "true",
    "ALLOW_DEVELOPMENT_IDENTITY": "true",
    "PUBLIC_SITE_ORIGIN": "https://anyaparallax.co.uk"
  }
}
