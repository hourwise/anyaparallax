# Dependencies
node_modules/

# Build output
build/
dist/
.vite/

# Framework / tooling generated types and state
.react-router/
.wrangler/

# Local environment and secrets (never commit these)
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
# ...but the EXAMPLE is documentation rather than local state, so it is committed on
