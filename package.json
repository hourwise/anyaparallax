{
  "name": "anyaparallax",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:routes": "node scripts/check-routes.mjs",
    "check:data": "node --experimental-strip-types --no-warnings scripts/run-checks.mjs",
    "check:images": "node scripts/generate-dev-images.mjs --check",
    "check:fixtures": "node scripts/check-upload-fixtures.mjs",
    "check:platform": "node scripts/checks/check-image-platform.mjs",
    "check:served": "node scripts/check-served-payload.mjs",
    "precheck": "pnpm run build && pnpm run check:fixtures",
    "check": "pnpm run typecheck && pnpm run check:routes && pnpm run check:data && pnpm run check:images && pnpm run check:platform && pnpm run check:served",
    "db:migrate:local": "wrangler d1 migrations apply anyaparallax --local",
    "db:migrate:remote": "wrangler d1 migrations apply anyaparallax --remote",
    "db:seed:local": "node --experimental-strip-types --no-warnings scripts/seed-local-d1.mjs",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.56.0",
    "@react-router/dev": "8.4.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "wrangler": "4.135.0"
  }
}
